{
  "name": "familyfoodplan-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/generate-prisma-client.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "pnpm run typecheck",
    "test": "pnpm run typecheck",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "node scripts/generate-prisma-client.mjs",
    "prisma:seed": "prisma db seed",
    "push:vapid-keys": "web-push generate-vapid-keys",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "express": "^4.19.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
