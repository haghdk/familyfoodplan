generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  VIEWER
}

model FamilyMember {
  id        Int         @id @default(autoincrement())
  name      String
  isActive  Boolean     @default(true)
  breakfasts BreakfastDish[]
  lunches   LunchDish[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Plan {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isCurrent Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  days      PlanDay[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PlanDay {
  id                Int                @id @default(autoincrement())
  planId            Int
  date              DateTime
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  dinnerDish        DinnerDish?
  breakfastDishes   BreakfastDish[]
  lunchDishes       LunchDish[]
  groceryItems      GroceryItem[]
  groceryShareToken GroceryShareToken?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([planId, date])
  @@index([planId])
}

model GroceryShareToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  planDayId Int      @unique
  planDay   PlanDay  @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DinnerDish {
  id          Int           @id @default(autoincrement())
  name        String
  notes       String?
  planDayId   Int           @unique
  planDay     PlanDay       @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  groceryItems GroceryItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model LunchDish {
  id             Int           @id @default(autoincrement())
  name           String
  notes          String?
  planDayId      Int
  familyMemberId Int?
  planDay        PlanDay       @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  groceryItems   GroceryItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([planDayId])
  @@index([familyMemberId])
}

model BreakfastDish {
  id             Int           @id @default(autoincrement())
  name           String
  notes          String?
  planDayId      Int
  familyMemberId Int?
  planDay        PlanDay       @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  groceryItems   GroceryItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([planDayId])
  @@index([familyMemberId])
}

enum GroceryCategory {
  GENERAL
  INGREDIENT
}

model GroceryItem {
  id           Int             @id @default(autoincrement())
  name         String
  quantity     Float           @default(1)
  unit         String?
  category     GroceryCategory @default(GENERAL)
  isChecked    Boolean         @default(false)
  planDayId    Int
  dinnerDishId Int?
  breakfastDishId Int?
  lunchDishId  Int?
  planDay      PlanDay         @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  dinnerDish   DinnerDish?     @relation(fields: [dinnerDishId], references: [id], onDelete: SetNull)
  breakfastDish BreakfastDish? @relation(fields: [breakfastDishId], references: [id], onDelete: SetNull)
  lunchDish    LunchDish?      @relation(fields: [lunchDishId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([planDayId])
  @@index([dinnerDishId])
  @@index([breakfastDishId])
  @@index([lunchDishId])
}
