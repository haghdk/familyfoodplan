generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FamilyMember {
  id        Int         @id @default(autoincrement())
  name      String
  isActive  Boolean     @default(true)
  lunches   LunchDish[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model PlanDay {
  id         Int          @id @default(autoincrement())
  date       DateTime     @unique
  dinnerDish DinnerDish?
  lunchDishes LunchDish[]
  groceryItems GroceryItem[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model DinnerDish {
  id        Int      @id @default(autoincrement())
  name      String
  notes     String?
  planDayId Int      @unique
  planDay   PlanDay  @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  groceryItems GroceryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LunchDish {
  id             Int          @id @default(autoincrement())
  name           String
  notes          String?
  planDayId      Int
  familyMemberId Int?
  planDay        PlanDay      @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  groceryItems   GroceryItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([planDayId])
  @@index([familyMemberId])
}

enum GroceryCategory {
  GENERAL
  INGREDIENT
}

model GroceryItem {
  id           Int             @id @default(autoincrement())
  name         String
  quantity     Float           @default(1)
  unit         String?
  category     GroceryCategory @default(GENERAL)
  planDayId    Int
  dinnerDishId Int?
  lunchDishId  Int?
  planDay      PlanDay         @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  dinnerDish   DinnerDish?     @relation(fields: [dinnerDishId], references: [id], onDelete: SetNull)
  lunchDish    LunchDish?      @relation(fields: [lunchDishId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([planDayId])
  @@index([dinnerDishId])
  @@index([lunchDishId])
}
