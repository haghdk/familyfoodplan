generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(ADMIN)
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  settings            UserSettings?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

/// Per-user preferences shown on the settings screen. Kept in its own table so
/// future settings can be added without widening the user row.
model UserSettings {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Whether this user wants the daily "today's dinner" push notification.
  /// Off until the user turns it on, since it needs browser permission anyway.
  dinnerReminderEnabled Boolean   @default(false)
  /// Whether this user wants the daily "these are going off soon" notification
  /// about the pantry. Its own flag rather than a share of the dinner one, so a
  /// household can have the shopping reminder without the expiry one.
  pantryExpiryReminderEnabled Boolean @default(false)
  /// The interface language this user picked, as a two-letter code ("en", "da").
  /// Stored on the account rather than only in a cookie so it follows the user
  /// to their other devices, and so reminders and emails can be written in it.
  language              String    @default("en")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// One row per browser/device that has granted push permission. The endpoint and
/// keys come straight from the browser's PushSubscription.
model PushSubscription {
  id        Int       @id @default(autoincrement())
  endpoint  String    @unique
  p256dhKey String
  authKey   String
  userAgent String?
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

/// Claim marker for the daily dinner reminder. The unique `dayKey` is what stops
/// a restart — or a second backend instance — from sending the same day twice.
model DinnerReminderLog {
  id             Int      @id @default(autoincrement())
  dayKey         String   @unique
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())
}

/// The same claim marker for the daily pantry expiry reminder, kept separate so
/// the two notifications can be sent, skipped and caught up independently.
model PantryExpiryLog {
  id             Int      @id @default(autoincrement())
  dayKey         String   @unique
  recipientCount Int      @default(0)
  /// How many pantry items the notification was about, for the log line.
  itemCount      Int      @default(0)
  sentAt         DateTime @default(now())
}

/// Password reset links. Only the SHA-256 hash of the token is stored, so a
/// database leak cannot be replayed as a reset link.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  ADMIN
  VIEWER
}

model FamilyMember {
  id        Int         @id @default(autoincrement())
  name      String
  isActive  Boolean     @default(true)
  breakfasts BreakfastDish[]
  lunches   LunchDish[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Plan {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isCurrent Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  days      PlanDay[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PlanDay {
  id                Int                @id @default(autoincrement())
  planId            Int
  date              DateTime
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  dinnerDish        DinnerDish?
  breakfastDishes   BreakfastDish[]
  lunchDishes       LunchDish[]
  groceryItems      GroceryItem[]
  groceryShareToken GroceryShareToken?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([planId, date])
  @@index([planId])
}

model GroceryShareToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  planDayId Int      @unique
  planDay   PlanDay  @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Something the family already has in a kitchen cabinet. It is kept as its own
/// list rather than as grocery items, because it outlives any one plan: a can of
/// beans bought in March is still on the shelf in June, and the point of the
/// list is to notice that before it goes off unopened.
model PantryItem {
  id             Int                @id @default(autoincrement())
  name           String
  quantity       Float              @default(1)
  unit           String?
  /// When the packaging says it goes off. Optional, since plenty of staples
  /// carry no date worth tracking.
  expirationDate DateTime?
  notes          String?
  allocations    PantryAllocation[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([expirationDate])
}

/// A record that a planned meal took an ingredient out of the cabinets instead
/// of putting it on the shopping list.
///
/// It exists because the pantry is decremented when the ingredients are copied:
/// without a record of what a meal has already claimed, a second press of "add
/// ingredients to grocery list" would empty the cabinet a second time. The
/// ingredient is stored by name rather than only by pantry row, so the claim
/// survives the row being used up and deleted.
model PantryAllocation {
  id              Int            @id @default(autoincrement())
  ingredientName  String
  unit            String?
  quantity        Float
  pantryItemId    Int?
  dinnerDishId    Int?
  breakfastDishId Int?
  lunchDishId     Int?
  pantryItem      PantryItem?    @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
  dinnerDish      DinnerDish?    @relation(fields: [dinnerDishId], references: [id], onDelete: Cascade)
  breakfastDish   BreakfastDish? @relation(fields: [breakfastDishId], references: [id], onDelete: Cascade)
  lunchDish       LunchDish?     @relation(fields: [lunchDishId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([pantryItemId])
  @@index([dinnerDishId])
  @@index([breakfastDishId])
  @@index([lunchDishId])
}

/// A shelf of the cookbook — "Soups", "Pasta". Categories are their own rows
/// rather than a fixed enum because what a family cooks is not a list anyone
/// can write down in advance, and it changes as the cookbook grows.
model DishCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  dishes    Dish[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A dish the family cooks again and again — lasagne, say — stored once with
/// everything it takes to make it. Dishes live outside any plan, so the same
/// dish can be picked for as many days as it is eaten on without its
/// ingredients being typed in again.
model Dish {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  notes           String?
  /// Which shelf of the cookbook this dish sits on. Optional, so a dish can be
  /// written down before anyone has decided what to call the group it belongs
  /// to, and so deleting a category leaves its dishes alone.
  categoryId      Int?
  category        DishCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients     DishIngredient[]
  dinnerDishes    DinnerDish[]
  breakfastDishes BreakfastDish[]
  lunchDishes     LunchDish[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
}

/// One line of a dish's recipe. Deliberately shaped like `GroceryItem`, since
/// copying these onto a plan's grocery list is what they exist for.
model DishIngredient {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Float    @default(1)
  unit      String?
  /// The order the ingredients are listed in on the dish, kept so the grocery
  /// list receives them the way they were written down.
  sortOrder Int      @default(0)
  dishId    Int
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dishId])
  @@index([dishId, sortOrder])
}

model DinnerDish {
  id          Int           @id @default(autoincrement())
  name        String
  notes       String?
  planDayId   Int           @unique
  /// Set when this meal was picked from the saved dishes rather than typed in,
  /// which is what makes its ingredients available to the grocery list. Cleared
  /// rather than cascading if the saved dish is later deleted, so the planned
  /// meal survives.
  dishId      Int?
  planDay     PlanDay       @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  dish        Dish?         @relation(fields: [dishId], references: [id], onDelete: SetNull)
  groceryItems GroceryItem[]
  pantryAllocations PantryAllocation[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([dishId])
}

model LunchDish {
  id             Int           @id @default(autoincrement())
  name           String
  notes          String?
  planDayId      Int
  familyMemberId Int?
  dishId         Int?
  planDay        PlanDay       @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  dish           Dish?         @relation(fields: [dishId], references: [id], onDelete: SetNull)
  groceryItems   GroceryItem[]
  pantryAllocations PantryAllocation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([planDayId])
  @@index([familyMemberId])
  @@index([dishId])
}

model BreakfastDish {
  id             Int           @id @default(autoincrement())
  name           String
  notes          String?
  planDayId      Int
  familyMemberId Int?
  dishId         Int?
  planDay        PlanDay       @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  dish           Dish?         @relation(fields: [dishId], references: [id], onDelete: SetNull)
  groceryItems   GroceryItem[]
  pantryAllocations PantryAllocation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([planDayId])
  @@index([familyMemberId])
  @@index([dishId])
}

enum GroceryCategory {
  GENERAL
  INGREDIENT
}

model GroceryItem {
  id           Int             @id @default(autoincrement())
  name         String
  quantity     Float           @default(1)
  unit         String?
  category     GroceryCategory @default(GENERAL)
  isChecked    Boolean         @default(false)
  /// Manual shopping order, maintained by drag-to-reorder on the grocery list.
  /// Numbered across the whole plan so items from different days share one order.
  sortOrder    Int             @default(0)
  planDayId    Int
  dinnerDishId Int?
  breakfastDishId Int?
  lunchDishId  Int?
  planDay      PlanDay         @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  dinnerDish   DinnerDish?     @relation(fields: [dinnerDishId], references: [id], onDelete: SetNull)
  breakfastDish BreakfastDish? @relation(fields: [breakfastDishId], references: [id], onDelete: SetNull)
  lunchDish    LunchDish?      @relation(fields: [lunchDishId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([planDayId])
  @@index([planDayId, sortOrder])
  @@index([dinnerDishId])
  @@index([breakfastDishId])
  @@index([lunchDishId])
}
