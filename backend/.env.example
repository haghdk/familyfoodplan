# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familyfoodplan?schema=public"

# Backend
PORT=3001
AUTH_JWT_SECRET="change-me"
FRONTEND_ORIGIN="http://localhost:3000"

# Prisma seed (first admin)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# Password reset links
# Public URL the emailed reset link points at. Falls back to FRONTEND_ORIGIN.
APP_PUBLIC_URL="http://localhost:3000"
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Push notifications (Web Push / VAPID)
# Generate a key pair once with: pnpm --dir backend push:vapid-keys
# Leave both empty in local development: notifications are logged to the backend
# console instead of being sent.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@example.com"

# Daily "today's dinner" reminder
DINNER_REMINDER_ENABLED="true"
DINNER_REMINDER_HOUR=10
DINNER_REMINDER_MINUTE=0
DINNER_REMINDER_TIMEZONE="Europe/Copenhagen"

# Outgoing email (SMTP)
# Leave SMTP_HOST empty in local development: reset links are logged to the
# backend console instead of being emailed.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Family Food Planner <no-reply@example.com>"
